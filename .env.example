# One same-origin server serves the API and web app (5173 in development, 3000 in production).
# PORT=5173
# SQLite file location; defaults to ./data/northstar.sqlite
# DATABASE_PATH=./data/northstar.sqlite

# Market data source: auto (default) | yahoo | finnhub | demo
#   auto    - Finnhub when FINNHUB_API_KEY is set, otherwise keyless Yahoo Finance.
#   yahoo   - real quotes and history from Yahoo Finance's public endpoints, no key needed.
#   finnhub - requires FINNHUB_API_KEY.
#   demo    - force the clearly labeled simulated feed (used by the test suite).
# MARKET_PROVIDER=auto

# Optional: Finnhub API key. When set (and MARKET_PROVIDER is auto/finnhub) it is preferred
# over Yahoo. Real quotes from either source may be delayed.
# FINNHUB_API_KEY=

# In production set BOTH of these to provision an admin account at first startup.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-long-unique-password

# Demo one-click login defaults to enabled in development, disabled in production.
# DEMO_MODE=true

# Optional manual external-transfer request workflow (OFF by default).
# This does not move money, keep a custody ledger, or change virtual cash.
# Enable only after arranging external settlement, reconciliation, and compliance.
# MANUAL_TRANSFERS_ENABLED=false
# Required when enabled: persistent 32-byte AES key, encoded as 64 hex characters.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Store in a secret manager or an untracked .env; never commit or share it.
# Losing/changing this key makes previously stored transfer details unreadable.
# TRANSFER_DETAILS_KEY=
